{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MCP server",
      "type": "debugpy",
      "request": "launch",
      "module": "mcp_server.server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "UI (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "ui/streamlit_app.py", "--server.port", "8501", "--browser.gatherUsageStats", "false"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Ingest documents",
      "type": "debugpy",
      "request": "launch",
      "module": "retrieval.ingest",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Run evals",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_evals.py",
      "args": ["--out", "evals/report.md"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (MCP + API + UI)",
      "configurations": ["MCP server", "API (FastAPI)", "UI (Streamlit)"],
      "stopAll": true
    }
  ]
}
