# Copy to .env and fill in. Only ANTHROPIC_API_KEY is strictly required;
# without PINECONE_API_KEY the assistant runs on the local keyword index.

# --- Models -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only for personal (identity-linked) keys not scoped to one workspace,
# e.g. wrkspc_01Jw... from the Console's workspace settings
ANTHROPIC_WORKSPACE_ID=
# Large model: supervisor, research planner, final answer
LLM_LARGE=anthropic:claude-sonnet-5-5
# Small model: batch analyzers, memory extraction, summaries
LLM_SMALL=anthropic:claude-haiku-5-5
# Optional fallback used when the primary model fails (needs its own key)
LLM_FALLBACK=
OPENAI_API_KEY=

# --- Pinecone ----------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=bank-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBED_MODEL=multilingual-e5-large
EMBED_DIMENSION=1024
RERANK_MODEL=bge-reranker-v2-m3

# --- LangSmith -----------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bank-ai-assistant

# --- API ------------------------------------------------------------------------
JWT_SECRET=change-me-in-any-shared-environment
STATE_DB=data/state/assistant.sqlite
MCP_SERVER_URL=http://localhost:8001/mcp
# Comma-separated faults to inject at startup for demos: llm,pinecone,mcp
FAULTS=

# --- UI -------------------------------------------------------------------------
API_URL=http://localhost:8000
